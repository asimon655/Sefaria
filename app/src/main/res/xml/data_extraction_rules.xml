<?xml version="1.0" encoding="utf-8"?>
<!-- Back up user data only (bookmarks, history, positions live in sefaria.db with the
     cache, so the database is excluded until user data moves to its own file). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
